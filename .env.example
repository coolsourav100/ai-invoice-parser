# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=invoice_parser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword

# ── Node.js Server ──
NODE_PORT=3001

# ── Python Inference Server ──
INFERENCE_URL=http://localhost:8000
INFERENCE_PORT=8000

# ── Hugging Face ──
# Your fine-tuned LoRA adapter on HF Hub (e.g., coolsourav100/invoice-qwen-lora)
HF_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
HF_ADAPTER_ID=coolsourav100/invoice-qwen-lora

# ── OpenAI Fallback (optional) ──
# OPENAI_API_KEY=sk-...
# OPENAI_FINE_TUNED_MODEL=ft:gpt-4o-mini-...
# INFERENCE_PROVIDER=local
